generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id            Int    @id(map: "pk_admin") @default(autoincrement())
  email         String @unique(map: "uq_admin_email")
  password_hash String
}

model dev_project_cross_ref {
  dev_id     Int
  project_id Int
  role       String
  developers developers @relation(fields: [dev_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_dev_project_dev")
  project    project    @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_dev_project_project")

  @@id([dev_id, project_id, role], map: "pk_dev_project_cross_ref")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model developers {
  id                    Int                     @id(map: "pk_developers") @default(autoincrement())
  name                  String?
  surname               String?
  nickname              String?
  dev_project_cross_ref dev_project_cross_ref[]
}

model project {
  id                      Int                       @id(map: "pk_project") @default(autoincrement())
  name                    String                    @unique(map: "uq_project_name")
  slug                    String                    @unique(map: "uq_project_slug")
  preview_url             String
  employer                String?
  description             String
  work_started            DateTime                  @db.Date
  work_ended              DateTime                  @db.Date
  is_featured             Boolean?                  @default(false)
  git                     String?
  dev_project_cross_ref   dev_project_cross_ref[]
  project_media           project_media[]
  stack_project_cross_ref stack_project_cross_ref[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model project_media {
  id         Int     @id(map: "pk_project_media") @default(autoincrement())
  type       String
  url        String
  sort_order Int?
  caption    String?
  project_id Int
  project    project @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_media_project")
}

model stack {
  id                      Int                       @id(map: "pk_stack") @default(autoincrement())
  technology              String                    @unique(map: "uq_stack_technology")
  stack_project_cross_ref stack_project_cross_ref[]
}

model stack_project_cross_ref {
  project_id    Int
  technology_id Int
  project       project @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stack_project_project")
  stack         stack   @relation(fields: [technology_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stack_project_stack")

  @@id([project_id, technology_id], map: "pk_stack_project_cross_ref")
}
